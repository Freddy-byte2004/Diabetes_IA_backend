# Example .env file for Diabetes_IA_backend
# Puerto en el que corre el servidor Express
PORT=5432

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000

# URL de conexión a la base de datos PostgreSQL (Supabase)
SUPABASE_DB_URL=postgresql://usuario:contraseña@host:puerto/base_de_datos

# Clave secreta para JWT
JWT_SECRET=tu_clave_secreta_super_segura

# Entorno de ejecución (development o production)
NODE_ENV=development
