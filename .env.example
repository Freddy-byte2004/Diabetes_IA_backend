# Example .env file for Diabetes_IA_backend

# Puerto en el que corre el servidor Express (Se recomienda 3000 o 5000; 5432 es reservado para PostgreSQL)
PORT=3000

# Orígenes permitidos para CORS (separados por coma si hay más de uno)
CORS_ORIGIN=http://localhost:3001

# URL de conexión a la base de datos PostgreSQL (Local, Docker o Supabase)
# Ejemplo local: postgresql://postgres:password@localhost:5432/diabetes_ia_db
# Ejemplo Supabase: postgresql://postgres:password@db.ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/base_de_datos

# Habilitar cifrado SSL para la conexión a la base de datos
# Usa 'false' para PostgreSQL local/Docker o 'true' para servicios en la nube (Supabase, Neon, etc.)
DB_SSL=false

# Clave secreta para firmar y verificar tokens JWT
JWT_SECRET=tu_clave_secreta_super_segura

# Entorno de ejecución (development o production)
NODE_ENV=development

# Clave de API para el servicio de envío de correos electrónicos (Resend)
RESEND_API_KEY=tu_api_key_de_resend

# Dirección de correo electrónico desde la cual se enviarán los correos (Resend)
RESEND_FROM=soporte@diabetes-ia.com